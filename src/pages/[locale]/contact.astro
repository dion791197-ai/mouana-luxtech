---
import Layout from '@/layouts/Layout.astro';
import ContactForm from '@/components/contact/ContactForm.astro';
import ContactInfo from '@/components/contact/ContactInfo.astro';
import ScrollReveal from '@/components/shared/ScrollReveal.astro';
import { locales, getDictionary, type Locale } from '@/lib/i18n';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;
const dict = getDictionary(locale);
const contactDict = dict.contact;
---

<Layout locale={locale} dict={dict} title={`${contactDict.title} | Mouana Phuket`}>
  <section class="relative h-[50vh] min-h-[400px] flex items-center justify-center bg-charcoal">
    <div class="text-center px-4 max-w-3xl">
      <h1 class="font-serif text-4xl md:text-5xl lg:text-6xl text-white font-light mb-4">
        {contactDict.title}
      </h1>
      <p class="text-white/70 text-lg leading-relaxed">{contactDict.subtitle}</p>
    </div>
  </section>

  <section class="py-20 md:py-28 px-4 md:px-8 max-w-7xl mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-5 gap-16">
      <div class="lg:col-span-3">
        <ScrollReveal>
          <h2 class="font-serif text-2xl md:text-3xl text-charcoal mb-8">{contactDict.formTitle}</h2>
          <ContactForm dict={dict} locale={locale} />
        </ScrollReveal>
      </div>

      <div class="lg:col-span-2">
        <ContactInfo dict={dict} />
      </div>
    </div>
  </section>
</Layout>
