---
import Layout from '@/layouts/Layout.astro';
import CompanyStory from '@/components/about/CompanyStory.astro';
import StatsCounter from '@/components/about/StatsCounter.astro';
import ServicesGrid from '@/components/about/ServicesGrid.astro';
import { locales, getDictionary, type Locale } from '@/lib/i18n';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;
const dict = getDictionary(locale);
const aboutPage = dict.aboutPage.hero;
---

<Layout locale={locale} dict={dict} title={`${aboutPage.title} | Mouana Phuket`}>
  <section class="relative h-[50vh] min-h-[400px] flex items-center justify-center bg-charcoal">
    <div class="text-center px-4 max-w-3xl">
      <h1 class="font-serif text-4xl md:text-5xl lg:text-6xl text-white font-light mb-4">
        {aboutPage.title}
      </h1>
      <p class="text-white/70 text-lg leading-relaxed">{aboutPage.description}</p>
    </div>
  </section>

  <CompanyStory dict={dict} />
  <StatsCounter />
  <ServicesGrid dict={dict} />
</Layout>
