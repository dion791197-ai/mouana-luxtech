---
import Layout from '@/layouts/Layout.astro';
import ScrollReveal from '@/components/shared/ScrollReveal.astro';
import { blogPosts, getAllBlogSlugs } from '@/data/blog';
import { locales, getDictionary, type Locale } from '@/lib/i18n';

export function getStaticPaths() {
  return getAllBlogSlugs().flatMap((slug) =>
    locales.map((locale) => ({ params: { locale, slug } }))
  );
}

const locale = Astro.params.locale as Locale;
const { slug } = Astro.params;
const dict = getDictionary(locale);
const blogDict = dict.blog;
const post = blogPosts.find((p) => p.slug === slug)!;

const paragraphs = post.content.split('\n\n');
---

<Layout locale={locale} dict={dict} title={post.metaTitle} description={post.metaDescription}>
  <section class="relative h-[60vh] min-h-[500px] flex items-end">
    <img src={post.coverImage} alt={post.title} class="absolute inset-0 w-full h-full object-cover" />
    <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/30 to-transparent"></div>

    <div class="relative z-10 max-w-4xl mx-auto px-4 md:px-8 pb-16 w-full">
      <a href={`/${locale}/blog`} class="inline-flex items-center gap-2 text-white/70 hover:text-white transition-colors mb-6 text-sm">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19-7-7 7-7"></path><path d="M19 12H5"></path></svg>
        {blogDict.backToBlog}
      </a>

      <h1 class="font-serif text-3xl md:text-4xl lg:text-5xl text-white font-light mb-4">{post.title}</h1>

      <div class="flex flex-wrap items-center gap-6 text-white/70 text-sm">
        <span class="flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
          {blogDict.publishedOn} {post.date}
        </span>
        <span class="flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
          {blogDict.byAuthor} {post.author}
        </span>
      </div>
    </div>
  </section>

  <section class="py-16 md:py-24 px-4 md:px-8">
    <div class="max-w-3xl mx-auto">
      <ScrollReveal>
        <article class="prose prose-lg max-w-none">
          {paragraphs.map((paragraph) =>
            paragraph.startsWith('## ') ? (
              <h2 class="font-serif text-2xl text-charcoal mt-12 mb-4">{paragraph.replace('## ', '')}</h2>
            ) : (
              <p class="text-warm-gray leading-relaxed mb-6">{paragraph}</p>
            )
          )}
        </article>

        <div class="mt-12 pt-8 border-t border-gray-200">
          <div class="flex items-center gap-3 flex-wrap">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" class="text-gold" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12.586 2.586A2 2 0 0 0 11.172 2H4a2 2 0 0 0-2 2v7.172a2 2 0 0 0 .586 1.414l8.704 8.704a2.426 2.426 0 0 0 3.42 0l6.58-6.58a2.426 2.426 0 0 0 0-3.42z"></path><circle cx="7.5" cy="7.5" r=".5" fill="currentColor"></circle></svg>
            {post.tags.map((tag) => (
              <span class="bg-cream text-charcoal text-sm px-4 py-1 rounded-full">{tag}</span>
            ))}
          </div>
        </div>
      </ScrollReveal>
    </div>
  </section>
</Layout>
