---
import Layout from '@/layouts/Layout.astro';
import ProjectHero from '@/components/projects/ProjectHero.astro';
import ProjectOverview from '@/components/projects/ProjectOverview.astro';
import MasterPlan from '@/components/projects/MasterPlan.astro';
import VillaTypeSection from '@/components/projects/VillaTypeSection.astro';
import ProjectGallery from '@/components/projects/ProjectGallery.astro';
import ContactCTA from '@/components/home/ContactCTA.astro';
import ScrollReveal from '@/components/shared/ScrollReveal.astro';
import { projects, getAllProjectSlugs } from '@/data/projects';
import { companyInfo } from '@/data/company';
import { locales, getDictionary, type Locale } from '@/lib/i18n';

export function getStaticPaths() {
  return getAllProjectSlugs().flatMap((slug) =>
    locales.map((locale) => ({ params: { locale, slug } }))
  );
}

const locale = Astro.params.locale as Locale;
const { slug } = Astro.params;
const dict = getDictionary(locale);
const projectsDict = dict.projects;
const project = projects.find((p) => p.slug === slug)!;
---

<Layout locale={locale} dict={dict} title={project.metaTitle} description={project.metaDescription}>
  <ProjectHero project={project} dict={projectsDict} />
  <ProjectOverview project={project} dict={projectsDict} />

  <section class="py-16 md:py-24 px-4 md:px-8 max-w-7xl mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
      <ScrollReveal class="lg:col-span-2">
        <span class="text-xs tracking-[0.3em] uppercase text-gold mb-4 block">
          {projectsDict.introduction || 'Introduction'}
        </span>
        <h2 class="font-serif text-3xl md:text-4xl font-light text-charcoal mb-6">{project.name}</h2>
        <p class="text-warm-gray leading-relaxed">{project.introduction}</p>
      </ScrollReveal>

      <ScrollReveal direction="right">
        <div class="bg-cream p-8 rounded-lg">
          <h3 class="font-serif text-lg text-charcoal mb-6">{dict.home.contact.title}</h3>
          <div class="space-y-4">
            <a href={`mailto:${companyInfo.contact.email}`} class="flex items-center gap-3 text-warm-gray hover:text-gold transition-colors text-sm">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" class="text-gold" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"></rect><path d="m22 7-10 5L2 7"></path></svg>
              {companyInfo.contact.email}
            </a>
            <a href={`tel:${companyInfo.contact.phone}`} class="flex items-center gap-3 text-warm-gray hover:text-gold transition-colors text-sm">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" class="text-gold" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13.832 16.568a1 1 0 0 0 1.213-.303l.355-.465A2 2 0 0 1 17 15h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2A18 18 0 0 1 2 4a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v3a2 2 0 0 1-.8 1.6l-.468.351a1 1 0 0 0-.292 1.233 14 14 0 0 0 6.392 6.384"></path></svg>
              {companyInfo.contact.phone}
            </a>
            <div class="flex items-center gap-3 text-warm-gray text-sm">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" class="text-gold" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"></path><circle cx="12" cy="10" r="3"></circle></svg>
              {project.location}
            </div>
          </div>
        </div>
      </ScrollReveal>
    </div>
  </section>

  <section class="py-16 md:py-24 bg-cream">
    <div class="max-w-7xl mx-auto px-4 md:px-8">
      <ScrollReveal>
        <span class="text-xs tracking-[0.3em] uppercase text-gold mb-4 block">Location</span>
        <h2 class="font-serif text-3xl md:text-4xl font-light text-charcoal mb-6">
          {projectsDict.location || 'Prime Location Advantage'}
        </h2>
        <p class="text-warm-gray leading-relaxed max-w-3xl">{project.locationAdvantage}</p>
      </ScrollReveal>
    </div>
  </section>

  <MasterPlan image={project.masterPlanImage} dict={projectsDict} />
  <VillaTypeSection villaTypes={project.villaTypes} dict={projectsDict} />
  <ProjectGallery images={project.gallery} name={project.name} dict={projectsDict} />
  <ContactCTA locale={locale} dict={dict} />
</Layout>
