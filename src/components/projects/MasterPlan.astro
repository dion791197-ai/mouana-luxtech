---
import ScrollReveal from '@/components/shared/ScrollReveal.astro';
import SectionHeading from '@/components/shared/SectionHeading.astro';

interface Props {
  image: string;
  dict: Record<string, string>;
}

const { image, dict } = Astro.props;
---

<section class="py-16 md:py-24 bg-cream">
  <div class="max-w-7xl mx-auto px-4 md:px-8">
    <SectionHeading title={dict.masterPlan || 'Master Plan'} />

    <ScrollReveal>
      <div class="relative aspect-[16/9] rounded-lg overflow-hidden shadow-xl bg-white">
        <img src={image} alt="Master Plan" class="w-full h-full object-contain" />
      </div>
    </ScrollReveal>
  </div>
</section>
