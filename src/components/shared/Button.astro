---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'outline';
  size?: 'sm' | 'md' | 'lg';
  class?: string;
  type?: 'button' | 'submit';
}

const {
  href,
  variant = 'primary',
  size = 'md',
  class: className = '',
  type = 'button',
} = Astro.props;

const base =
  'inline-flex items-center justify-center font-medium tracking-wide transition-all duration-300 hover:scale-[1.02] active:scale-[0.98]';

const variants = {
  primary: 'bg-charcoal text-white hover:bg-charcoal-light',
  secondary: 'bg-gold text-white hover:bg-gold-dark',
  outline: 'border-2 border-charcoal text-charcoal hover:bg-charcoal hover:text-white',
};

const sizes = {
  sm: 'px-5 py-2 text-xs',
  md: 'px-7 py-3 text-sm',
  lg: 'px-10 py-4 text-base',
};

const classes = `${base} ${variants[variant]} ${sizes[size]} ${className}`;
const Tag = href ? 'a' : 'button';
---

<Tag class={classes} href={href} type={!href ? type : undefined}>
  <slot />
</Tag>
