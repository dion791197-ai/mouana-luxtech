---
import { companyInfo } from '@/data/company';
import { projects } from '@/data/projects';
import type { Locale, Dictionary } from '@/lib/i18n';

interface Props {
  locale: Locale;
  dict: Dictionary;
}

const { locale, dict } = Astro.props;
const { footer } = dict;
const { contact } = companyInfo;
---

<footer class="bg-charcoal text-white">
  <div class="max-w-7xl mx-auto px-4 md:px-8 py-16 md:py-20">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12">
      <div>
        <a href={`/${locale}`} class="font-serif text-2xl tracking-wider">
          MOUANA<span class="text-gold ml-1">PHUKET</span>
        </a>
        <p class="mt-6 text-white/60 text-sm leading-relaxed">
          {footer.description}
        </p>
      </div>

      <div>
        <h4 class="font-serif text-lg mb-6">{footer.contact}</h4>
        <div class="space-y-4">
          <a href={`mailto:${contact.email}`} class="flex items-start gap-3 text-white/60 hover:text-gold transition-colors text-sm">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 flex-shrink-0"><rect x="2" y="4" width="20" height="16" rx="2"></rect><path d="m22 7-10 5L2 7"></path></svg>
            {contact.email}
          </a>
          <a href={`tel:${contact.phone}`} class="flex items-start gap-3 text-white/60 hover:text-gold transition-colors text-sm">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 flex-shrink-0"><path d="M13.832 16.568a1 1 0 0 0 1.213-.303l.355-.465A2 2 0 0 1 17 15h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2A18 18 0 0 1 2 4a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v3a2 2 0 0 1-.8 1.6l-.468.351a1 1 0 0 0-.292 1.233 14 14 0 0 0 6.392 6.384"></path></svg>
            {contact.phone}
          </a>
          <div class="flex items-start gap-3 text-white/60 text-sm">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 flex-shrink-0"><path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"></path><circle cx="12" cy="10" r="3"></circle></svg>
            {contact.address}
          </div>
        </div>
      </div>

      <div>
        <h4 class="font-serif text-lg mb-6">{footer.navigation}</h4>
        <div class="space-y-3">
          {projects.slice(0, 7).map((project) => (
            <a href={`/${locale}/projects/${project.slug}`} class="block text-white/60 hover:text-gold transition-colors text-sm">
              {project.name}
            </a>
          ))}
        </div>
      </div>

      <div>
        <h4 class="font-serif text-lg mb-6">{footer.enquire}</h4>
        <a
          href={`/${locale}/contact`}
          class="inline-block text-gold border border-gold px-6 py-3 text-sm tracking-wide hover:bg-gold hover:text-white transition-all"
        >
          {footer.contactUs}
        </a>
      </div>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="max-w-7xl mx-auto px-4 md:px-8 py-6 flex flex-col md:flex-row items-center justify-between gap-4">
      <p class="text-white/40 text-xs">{footer.copyright}</p>
      <p class="text-white/40 text-xs">{footer.developedBy}</p>
    </div>
  </div>
</footer>
