---
import type { BlogPost } from '@/types/blog';
import type { Locale } from '@/lib/i18n';

interface Props {
  post: BlogPost;
  locale: Locale;
}

const { post, locale } = Astro.props;
---

<a href={`/${locale}/blog/${post.slug}`} class="group block">
  <div class="relative aspect-[16/10] overflow-hidden mb-4">
    <img
      src={post.coverImage}
      alt={post.title}
      loading="lazy"
      class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
    />
  </div>

  <div class="flex items-center gap-4 mb-3">
    <time class="text-warm-gray text-xs">{post.date}</time>
    <div class="flex gap-2">
      {post.tags.slice(0, 2).map((tag) => (
        <span class="text-xs bg-cream text-charcoal px-2 py-0.5 rounded">{tag}</span>
      ))}
    </div>
  </div>

  <h3 class="font-serif text-xl text-charcoal group-hover:text-gold transition-colors mb-2 line-clamp-2">
    {post.title}
  </h3>
  <p class="text-warm-gray text-sm line-clamp-3">{post.excerpt}</p>
</a>
