---
import ScrollReveal from '@/components/shared/ScrollReveal.astro';
import Button from '@/components/shared/Button.astro';
import { getProjectBySlug } from '@/data/projects';
import { companyInfo } from '@/data/company';
import type { Locale, Dictionary } from '@/lib/i18n';

interface Props {
  locale: Locale;
  dict: Dictionary;
}

const { locale, dict } = Astro.props;
const home = dict.home.latestProject;
const { contact } = companyInfo;
const project = getProjectBySlug('mouana-grande-chalong-bay')!;
---

<section class="py-20 md:py-28 px-4 md:px-8 max-w-7xl mx-auto">
  <ScrollReveal>
    <span class="text-xs tracking-[0.3em] uppercase text-gold mb-4 block">{home.label}</span>
  </ScrollReveal>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
    <ScrollReveal direction="left">
      <div class="relative aspect-[4/3] overflow-hidden">
        <img src={project.heroImage} alt={project.name} loading="lazy" class="w-full h-full object-cover" />
      </div>
    </ScrollReveal>

    <ScrollReveal direction="right">
      <h2 class="font-serif text-3xl md:text-4xl font-light text-charcoal mb-4">{project.name}</h2>
      <p class="text-gold text-sm tracking-wide mb-6">{project.tagline}</p>

      <div class="space-y-3 mb-8">
        <div class="flex items-center gap-3 text-warm-gray text-sm">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" class="text-gold" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"></rect><path d="m22 7-10 5L2 7"></path></svg>
          {contact.email}
        </div>
        <div class="flex items-center gap-3 text-warm-gray text-sm">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" class="text-gold" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13.832 16.568a1 1 0 0 0 1.213-.303l.355-.465A2 2 0 0 1 17 15h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2A18 18 0 0 1 2 4a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v3a2 2 0 0 1-.8 1.6l-.468.351a1 1 0 0 0-.292 1.233 14 14 0 0 0 6.392 6.384"></path></svg>
          {contact.phone}
        </div>
        <div class="flex items-center gap-3 text-warm-gray text-sm">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" class="text-gold" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"></path><circle cx="12" cy="10" r="3"></circle></svg>
          {project.location}
        </div>
      </div>

      <p class="text-warm-gray leading-relaxed mb-8">
        {project.description}
      </p>

      <div class="flex flex-wrap gap-4">
        <Button href={`/${locale}/projects/${project.slug}`} variant="primary">See Details</Button>
        <Button href={`/${locale}/contact`} variant="outline">{home.cta}</Button>
      </div>
    </ScrollReveal>
  </div>
</section>
